# Copy to .env on the production droplet and fill in.
#
#   cp env.example .env
#
# Named without a leading dot on purpose: .gitignore matches `.env.*`, so a file
# called .env.example is silently untracked. The repo root uses the same
# convention for the same reason.

# Hostname with a DNS A record pointing at this droplet. Caddy gets a
# Let's Encrypt certificate for it automatically on first boot. Required —
# the app is served over HTTPS and browsers block plaintext calls from an
# HTTPS page, so a bare droplet IP does not work.
OSRM_DOMAIN=osrm.firstknock.online

# Shared bearer token the app sends. Generate with: openssl rand -hex 32
# Ships to the browser, so treat it as obfuscation, not a secret: it stops
# drive-by scanners finding free compute, not a determined user of the app.
OSRM_TOKEN=

# Origin allowed by CORS. Must match the app's origin exactly.
APP_ORIGIN=https://firstknock.online

# Optional: Slack-compatible incoming webhook for watchdog alerts.
ALERT_WEBHOOK=

# Optional: lets the watchdog reboot the droplet at T3.
# Scope the token to write access on this droplet only.
DO_API_TOKEN=
DO_DROPLET_ID=

# Alert when free disk on /data drops below this many GB.
DISK_ALERT_GB=15
