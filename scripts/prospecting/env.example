# Copy to scripts/prospecting/.env.prospecting. Never commit the populated file.
# Apollo MCP does not require a local key. APOLLO_API_KEY is only for unattended CLI discovery.
APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io/api/v1

# Independent verification after Apollo enrichment.
EMAIL_VERIFIER=hunter
HUNTER_API_KEY=
HUNTER_BASE_URL=https://api.hunter.io/v2

# Alternative independent verifier.
MILLIONVERIFIER_API_KEY=
MILLIONVERIFIER_BASE_URL=https://api.millionverifier.com/api/v3
