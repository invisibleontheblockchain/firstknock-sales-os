# FORMAT REFERENCE ONLY. Store real values in Base44 server secrets, never in git.
# The readiness checker rejects these placeholders.

CANVAS_DATABASE_URL=postgresql://<canvas-role>:<password>@<host>/<canvas-database>?sslmode=require
CANVAS_OPERATIONAL_MIGRATION_SECRET=<independent-random-48-byte-secret>
CANVAS_DEPLOYMENT_SIGNING_SECRET=<independent-random-48-byte-secret>

CANVAS_ANALYSIS_SERVICE_URL=https://<canvas-analysis-host>
CANVAS_ANALYSIS_SERVICE_TOKEN=<independent-random-48-byte-secret>

CANVAS_PACKAGE_SIGNING_PRIVATE_KEY=<base64-pkcs8-der-ed25519-private-key>
CANVAS_PACKAGE_SIGNING_PRIVATE_KEY_FORMAT=pkcs8
CANVAS_PACKAGE_SIGNING_PUBLIC_KEY=<base64-spki-der-ed25519-public-key>
CANVAS_PACKAGE_SIGNING_PUBLIC_KEY_FORMAT=spki
CANVAS_PACKAGE_SIGNING_KEY_ID=canvas-field-packages-<yyyy-mm>

# Keep false or unset in production. True is only for isolated legacy v1 tests.
CANVAS_ALLOW_PUBLIC_OVERPASS_FALLBACK=false
