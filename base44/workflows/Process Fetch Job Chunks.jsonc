{
  "name": "Process Fetch Job Chunks",
  "description": "Triggers background processing of RentCast API data in chunks. Each chunk fetches ~15 pages, writes to DB, then updates the FetchJob to trigger the next chunk until complete.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "FetchJob"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "process_fetch_job_chunks",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processFetchChunk",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "processFetchChunk"
  }
}