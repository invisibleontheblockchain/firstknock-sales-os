{
  "name": "Route Optimization Job Sweep",
  "description": "Every 5 minutes, restarts background road searches that are queued or whose worker stopped (lease expired). Each job resumes from its last saved pass.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": "2026-10-17T00:00:00.000000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "route_optimization_job_sweep",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "advanceRouteOptimizationJob",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}
