{
  "name": "TeamMessage",
  "type": "object",
  "properties": {
    "sender_name": {
      "type": "string",
      "description": "Display name of sender"
    },
    "sender_email": {
      "type": "string",
      "description": "Email of sender"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "rep",
        "manager",
        "admin"
      ],
      "description": "Role of sender"
    },
    "manager_id": {
      "type": "string",
      "description": "Manager/account ID that owns this message thread"
    },
    "participant_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lowercase email addresses allowed to see this message"
    },
    "channel": {
      "type": "string",
      "description": "Account-scoped channel ID - manager_id for team, general_<manager_id> for account general, group_<id> for custom groups, dm_<hash> for DMs"
    },
    "channel_name": {
      "type": "string",
      "description": "Human-readable channel name for display"
    },
    "message": {
      "type": "string",
      "description": "Message content"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "alert",
        "celebration",
        "system"
      ],
      "default": "text"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description or notes for this record"
    }
  },
  "required": [
    "sender_name",
    "message",
    "channel",
    "manager_id"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "manager_id": "{{user.id}}"
        },
        {
          "manager_id": "{{user.data.team_manager_id}}"
        },
        {
          "participant_emails": "{{user.email}}"
        },
        {
          "sender_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "manager_id": "{{user.id}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "sender_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "manager_id": "{{user.id}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "sender_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}