{
  "name": "CanvasSession",
  "type": "object",
  "properties": {
    "session_name": {
      "type": "string",
      "description": "Manager-facing name for this Canvas territory campaign"
    },
    "territory_model": {
      "type": "string",
      "enum": [
        "street_territory_v1"
      ],
      "default": "street_territory_v1",
      "description": "Canvas is territory-first. Houses are created as field pins, not preloaded into the campaign."
    },
    "polygon": {
      "type": "array",
      "description": "Manager-drawn global campaign boundary",
      "items": {
        "type": "object",
        "properties": {
          "lat": { "type": "number" },
          "lng": { "type": "number" }
        }
      }
    },
    "rep_count": {
      "type": "integer",
      "default": 1
    },
    "planning_method": {
      "type": "string",
      "enum": [
        "street_workload",
        "preview_only"
      ],
      "default": "preview_only"
    },
    "assignment_basis": {
      "type": "string",
      "enum": [
        "street_work_unit_ids",
        "legacy_geometry"
      ],
      "default": "legacy_geometry",
      "description": "Production deployments assign an exclusive partition of street work units."
    },
    "workload_basis": {
      "type": "string",
      "enum": [
        "street_length",
        "street_length_plus_estimated_doors"
      ],
      "default": "street_length"
    },
    "division_mode": {
      "type": "string",
      "enum": [
        "selected_reps",
        "area_count",
        "street_workload_target"
      ],
      "default": "selected_reps",
      "description": "How the manager chooses the number of areas: one per selected rep, a fixed area count, or a target amount of street work per area."
    },
    "target_workload": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "For street_workload_target, the positive target class-weighted street meters per territory. Null for other division modes."
    },
    "selected_team_member_ids": {
      "type": "array",
      "description": "Manager-selected TeamMember IDs; selected-rep plans require one zone per rep.",
      "items": { "type": "string" }
    },
    "zones": {
      "type": "array",
      "description": "Connected, street-aligned territories with assignment and workload metadata",
      "items": { "type": "object" }
    },
    "work_units": {
      "type": "array",
      "description": "Canonical road segments used to enforce field-pin ownership without a preloaded house inventory",
      "items": { "type": "object" }
    },
    "qa": {
      "type": "object",
      "description": "Street partition diagnostics and deployment gates"
    },
    "deployment_qa": {
      "type": "object",
      "description": "Server-derived deployment and lifecycle evidence"
    },
    "algorithm_version": { "type": "string" },
    "data_version": { "type": "string" },
    "plan_hash": {
      "type": "string",
      "description": "Server-computed SHA-256 digest of the normalized territory plan"
    },
    "version": {
      "type": "integer",
      "default": 1
    },
    "deployment_plan_version": { "type": "integer" },
    "draft_saved_at": { "type": "string", "format": "date-time" },
    "deployed_at": { "type": "string", "format": "date-time" },
    "deployed_by_user_id": { "type": "string" },
    "deployment_idempotency_key": { "type": "string" },
    "deployment_signature": {
      "type": "string",
      "description": "Server HMAC proving the immutable plan and lifecycle snapshot"
    },
    "lifecycle_state": {
      "type": "string",
      "enum": ["active", "completed", "recalled"]
    },
    "lifecycle_evidence": { "type": "object" },
    "closed_at": { "type": "string", "format": "date-time" },
    "closed_by_user_id": { "type": "string" },
    "close_action": {
      "type": "string",
      "enum": ["complete", "recall"]
    },
    "close_idempotency_key": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["draft", "deployed", "completed", "recalled"],
      "default": "draft"
    },
    "manager_id": { "type": "string" },
    "canvas_field_write_lock_token": {
      "type": "string",
      "description": "Short-lived service-owned lock for idempotent pin/event writes",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "canvas_field_write_lock_acquired_at": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "canvas_field_write_lock_expires_at": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    }
  },
  "required": [
    "territory_model",
    "polygon",
    "rep_count",
    "zones",
    "work_units",
    "status",
    "manager_id"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$or": [
        { "manager_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
