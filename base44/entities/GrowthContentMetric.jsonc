{
  "name": "GrowthContentMetric",
  "type": "object",
  "properties": {
    "platform": {
      "type": "string",
      "enum": [
        "instagram",
        "tiktok"
      ],
      "default": "instagram",
      "description": "Social platform that owns this content checkpoint; legacy rows without a value are Instagram"
    },
    "campaign": {
      "type": "string",
      "maxLength": 120
    },
    "content": {
      "type": "string",
      "maxLength": 120,
      "description": "Platform content ID shared with utm_content"
    },
    "format": {
      "type": "string",
      "enum": [
        "reel",
        "carousel",
        "story",
        "collab",
        "live",
        "other"
      ],
      "default": "reel"
    },
    "hook": {
      "type": "string",
      "maxLength": 300
    },
    "cta_variant": {
      "type": "string",
      "maxLength": 120
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "snapshot_days": {
      "type": "integer",
      "enum": [
        1,
        3,
        7,
        30
      ],
      "default": 7
    },
    "snapshot_captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "reach": {
      "type": "integer",
      "minimum": 0
    },
    "views": {
      "type": "integer",
      "minimum": 0
    },
    "shares": {
      "type": "integer",
      "minimum": 0
    },
    "saves": {
      "type": "integer",
      "minimum": 0
    },
    "comments": {
      "type": "integer",
      "minimum": 0
    },
    "follows": {
      "type": "integer",
      "minimum": 0
    },
    "profile_visits": {
      "type": "integer",
      "minimum": 0
    },
    "link_clicks": {
      "type": "integer",
      "minimum": 0
    },
    "dm_intents": {
      "type": "integer",
      "minimum": 0
    },
    "snapshot_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Service-computed hash used to bind growth decisions to exact snapshot evidence"
    },
    "metric_source": {
      "type": "string",
      "enum": [
        "buffer"
      ],
      "description": "Automated provider that produced this fixed-age checkpoint; omitted on legacy/manual rows"
    },
    "provider_post_id": {
      "type": "string",
      "maxLength": 300
    },
    "provider_channel_id": {
      "type": "string",
      "maxLength": 300
    },
    "provider_metrics_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider_metrics_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Hash of normalized allowlisted Buffer count metrics and exact post/channel identity"
    },
    "provider_observed_metric_types": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "reach",
          "views",
          "shares",
          "saves",
          "comments",
          "follows"
        ]
      },
      "description": "Exact allowlisted metric types actually returned by Buffer; omitted fields are unknown, not zero"
    },
    "observed_metric_fields": {
      "type": "array",
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "reach",
          "views",
          "shares",
          "saves",
          "comments",
          "follows",
          "profile_visits",
          "link_clicks",
          "dm_intents"
        ]
      },
      "description": "Exact fields supplied in a manual checkpoint; absent fields are unknown, not zero"
    },
    "artifact_key": {
      "type": "string",
      "maxLength": 120
    },
    "concept_id": {
      "type": "string",
      "maxLength": 120
    },
    "growth_batch_key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "campaign",
    "content",
    "snapshot_days",
    "snapshot_captured_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "id": "__service_role_only__"
      }
    },
    "read": {
      "user_condition": {
        "id": "__service_role_only__"
      }
    },
    "update": {
      "user_condition": {
        "id": "__service_role_only__"
      }
    },
    "delete": {
      "user_condition": {
        "id": "__service_role_only__"
      }
    }
  }
}
