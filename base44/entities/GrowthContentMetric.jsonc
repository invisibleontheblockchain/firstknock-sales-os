{
  "name": "GrowthContentMetric",
  "type": "object",
  "properties": {
    "campaign": {
      "type": "string",
      "maxLength": 120
    },
    "content": {
      "type": "string",
      "maxLength": 120,
      "description": "Instagram content ID shared with utm_content"
    },
    "format": {
      "type": "string",
      "enum": [
        "reel",
        "carousel",
        "story",
        "collab",
        "live",
        "other"
      ],
      "default": "reel"
    },
    "hook": {
      "type": "string",
      "maxLength": 300
    },
    "cta_variant": {
      "type": "string",
      "maxLength": 120
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "snapshot_days": {
      "type": "integer",
      "enum": [
        1,
        3,
        7,
        30
      ],
      "default": 7
    },
    "snapshot_captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "reach": {
      "type": "integer",
      "minimum": 0
    },
    "views": {
      "type": "integer",
      "minimum": 0
    },
    "shares": {
      "type": "integer",
      "minimum": 0
    },
    "saves": {
      "type": "integer",
      "minimum": 0
    },
    "comments": {
      "type": "integer",
      "minimum": 0
    },
    "follows": {
      "type": "integer",
      "minimum": 0
    },
    "profile_visits": {
      "type": "integer",
      "minimum": 0
    },
    "link_clicks": {
      "type": "integer",
      "minimum": 0
    },
    "dm_intents": {
      "type": "integer",
      "minimum": 0
    },
    "snapshot_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Service-computed hash used to bind growth decisions to exact snapshot evidence"
    }
  },
  "required": [
    "campaign",
    "content",
    "snapshot_days",
    "snapshot_captured_at",
    "reach"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "id": "__service_role_only__"
      }
    },
    "read": {
      "user_condition": {
        "id": "__service_role_only__"
      }
    },
    "update": {
      "user_condition": {
        "id": "__service_role_only__"
      }
    },
    "delete": {
      "user_condition": {
        "id": "__service_role_only__"
      }
    }
  }
}
