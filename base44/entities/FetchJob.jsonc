{
  "name": "FetchJob",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "cancelled"
      ],
      "default": "pending"
    },
    "provider": {
      "type": "string",
      "enum": [
        "rentcast",
        "batchdata",
        "manual",
        "canvas"
      ],
      "description": "External/provider source used for the job"
    },
    "mode_tag": {
      "type": "string",
      "enum": [
        "PRECISION_TARGET",
        "CANVAS_DOOR",
        "LEGACY_RENTCAST"
      ],
      "description": "Pipeline mode: BatchData Precision or Canvas door logging"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "radius": {
      "type": "number"
    },
    "polygon": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          }
        }
      }
    },
    "fips_code": {
      "type": "string",
      "description": "County FIPS resolved from the selected area for BatchData pulls"
    },
    "area_sq_mi": {
      "type": "number",
      "description": "Computed selected area in square miles"
    },
    "polygon_hash": {
      "type": "string",
      "description": "Stable hash of the selected area for dedupe and delta checks"
    },
    "estimated_record_count": {
      "type": "integer",
      "default": 0,
      "description": "Estimated or capped records before paid BatchData pull"
    },
    "estimated_cost": {
      "type": "number",
      "default": 0,
      "description": "Estimated BatchData cost for the job"
    },
    "dry_run_metadata": {
      "type": "object",
      "description": "No-cost preview details for drawn area and cost modeling"
    },
    "sold_months": {
      "type": "number",
      "default": 12,
      "description": "How many months back to search for sold properties"
    },
    "include_mls": {
      "type": "boolean",
      "default": false,
      "description": "Legacy field retained during BatchData migration; MLS/RentCast paths should be removed before cutover"
    },
    "pull_mode": {
      "type": "string",
      "enum": [
        "new_area",
        "delta_refresh",
        "full_refresh"
      ],
      "default": "new_area",
      "description": "Data pull mode: new area, delta refresh, or full refresh/fill gaps"
    },
    "force_full_refresh": {
      "type": "boolean",
      "default": false,
      "description": "True when the user manually requested a full re-scan to fill missing grid cells"
    },
    "is_delta_pull": {
      "type": "boolean",
      "default": false,
      "description": "True if this is a CDC delta-pull"
    },
    "delta_watermark": {
      "type": "string",
      "format": "date-time",
      "description": "High-watermark timestamp"
    },
    "delta_savings": {
      "type": "object",
      "properties": {
        "estimated_full_calls": {
          "type": "integer"
        },
        "actual_calls": {
          "type": "integer"
        },
        "savings_pct": {
          "type": "number"
        }
      }
    },
    "sub_circles": {
      "type": "array",
      "description": "Legacy RentCast grid subdivision circles retained until cutover completes",
      "items": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "radius": {
            "type": "number"
          }
        }
      }
    },
    "current_sub_circle": {
      "type": "integer",
      "default": 0
    },
    "completed_sub_circles": {
      "type": "integer",
      "default": 0,
      "description": "Number of grid sub-circles fully processed during this job"
    },
    "total_sub_circles": {
      "type": "integer",
      "default": 1
    },
    "current_offset": {
      "type": "integer",
      "default": 0
    },
    "total_expected": {
      "type": "integer",
      "default": 0
    },
    "total_fetched": {
      "type": "integer",
      "default": 0
    },
    "total_inserted": {
      "type": "integer",
      "default": 0
    },
    "total_existed": {
      "type": "integer",
      "default": 0
    },
    "total_updated": {
      "type": "integer",
      "default": 0
    },
    "total_api_calls": {
      "type": "integer",
      "default": 0
    },
    "total_batchdata_calls": {
      "type": "integer",
      "default": 0
    },
    "error_message": {
      "type": "string"
    },
    "error_log": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "user_email": {
      "type": "string"
    },
    "precision_usage_user_id": {
      "type": "string",
      "description": "Service-stamped Base44 user ID that owns this billing usage event"
    },
    "precision_usage_kind": {
      "type": "string",
      "enum": [
        "trial",
        "paid",
        "unmetered"
      ],
      "description": "Service-stamped allowance bucket; never derived from mutable routes"
    },
    "precision_subscription_id": {
      "type": "string",
      "description": "Stripe subscription verified when the paid reservation was created"
    },
    "precision_invoice_id": {
      "type": "string",
      "description": "Current positive Stripe invoice verified when the paid reservation was created"
    },
    "precision_usage_period_start": {
      "type": "string",
      "format": "date-time",
      "description": "Stripe period stamped at pull start so jobs crossing renewal stay in their original bucket"
    },
    "precision_usage_period_end": {
      "type": "string",
      "format": "date-time"
    },
    "precision_usage_reserved": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Capacity held while a service-owned Precision fetch is pending or running"
    },
    "precision_usage_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Final count of qualifying properties delivered by this service-owned fetch"
    },
    "precision_usage_recorded_at": {
      "type": "string",
      "format": "date-time",
      "description": "Present only after the reservation has been settled to an actual delivered count"
    },
    "precision_cancel_requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "Durable service-owned cancellation intent. The reservation remains held until the processor settles an exact delivered count."
    },
    "precision_watchdog_recovery_at": {
      "type": "string",
      "format": "date-time",
      "description": "Durable watchdog recovery marker. The processor must settle exact delivered usage before the watchdog can fail the job."
    },
    "processor_claim_id": {
      "type": "string",
      "description": "Server-owned fencing token for the one worker authorized to issue provider calls and persist results"
    },
    "processor_claimed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp at which the current durable processor fencing token was claimed"
    },
    "processor_heartbeat_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last conditional heartbeat written by the worker that owns processor_claim_id"
    },
    "source_fetch_job_id": {
      "type": "string",
      "description": "Server-stamped immediate source FetchJob for a verified retry attempt"
    },
    "root_fetch_job_id": {
      "type": "string",
      "description": "Server-stamped root FetchJob for the durable attempt chain"
    },
    "attempt_number": {
      "type": "integer",
      "minimum": 1,
      "description": "Server-generated attempt number within the durable retry chain"
    },
    "attempt_reason": {
      "type": "string",
      "enum": [
        "initial_request",
        "verified_retry"
      ],
      "description": "Server-owned reason for creating this attempt"
    },
    "attempt_created_at": {
      "type": "string",
      "format": "date-time"
    },
    "attempt_actor_user_id": {
      "type": "string",
      "description": "Authenticated actor immutable user ID; never accepted from request input"
    },
    "attempt_subject_user_id": {
      "type": "string",
      "description": "Authorized subject immutable user ID"
    },
    "attempt_workspace_id": {
      "type": "string",
      "description": "Server-derived workspace identity for this attempt"
    },
    "source_criteria_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "source_polygon_hash": {
      "type": "string"
    },
    "source_effective_count": {
      "type": "integer",
      "minimum": 1
    },
    "source_status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "source_terminal_at": {
      "type": "string",
      "format": "date-time"
    },
    "progress_pct": {
      "type": "number",
      "default": 0
    },
    "zip_codes_found": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phase1_union_records": {
      "type": "array",
      "description": "Legacy field retained until RentCast gap-fill is removed",
      "items": {
        "type": "object"
      }
    },
    "chunk_number": {
      "type": "integer",
      "default": 0
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "chunk_timings": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "phase": {
      "type": "string",
      "enum": [
        "deed_records",
        "listings_records",
        "batchdata_precision",
        "batchdata_requesting",
        "batchdata_scanning",
        "canvas_session",
        "complete"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description or notes for this record"
    }
  },
  "required": [
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "id": "__service_role_only__"
      }
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "id": "__service_role_only__"
      }
    },
    "delete": {
      "user_condition": {
        "id": "__service_role_only__"
      }
    }
  }
}
