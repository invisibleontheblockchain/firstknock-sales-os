{
  "name": "RouteAnchor",
  "type": "object",
  "properties": {
    "manager_id": { "type": "string" },
    "route_id": { "type": "string" },
    "location": {
      "type": "object",
      "properties": {
        "address": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" }
      }
    }
  },
  "required": ["manager_id", "route_id", "location"],
  "rls": { "create": false, "read": false, "update": false, "delete": false }
}
