{
  "name": "InviteCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "The secret PIN code",
      "rls": {
        "write": {
          "$or": [
            { "data.linked_user_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } }
          ]
        }
      }
    },
    "role": {
      "type": "string",
      "enum": [
        "rep",
        "manager",
        "admin"
      ],
      "description": "Role to assign when used",
      "rls": {
        "write": {
          "$or": [
            {
              "$and": [
                { "data.linked_user_id": "{{user.id}}" },
                { "data.role": "rep" }
              ]
            },
            { "user_condition": { "role": "admin" } }
          ]
        }
      }
    },
    "label": {
      "type": "string",
      "description": "Description of who this code is for"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "rls": {
        "write": {
          "$or": [
            { "data.linked_user_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } }
          ]
        }
      }
    },
    "max_uses": {
      "type": "integer",
      "default": 1,
      "description": "Maximum number of times this code can be used",
      "rls": {
        "write": {
          "$or": [
            { "data.linked_user_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } }
          ]
        }
      }
    },
    "used_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of times this code has been used",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "linked_user_id": {
      "type": "string",
      "description": "ID of the manager who owns this code (if linked to subscription)",
      "rls": {
        "write": {
          "$or": [
            { "data.linked_user_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } }
          ]
        }
      }
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description or notes for this record"
    }
  },
  "required": [
    "code",
    "role"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "linked_user_id": "{{user.id}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "linked_user_id": "{{user.id}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "linked_user_id": "{{user.id}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
