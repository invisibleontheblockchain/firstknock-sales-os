{
  "name": "InteractionLog",
  "type": "object",
  "properties": {
    "address_hash": {
      "type": "string",
      "description": "Link to MasterProperty"
    },
    "manager_id": {
      "type": "string",
      "description": "Manager user ID of the creator's team (tenant key for RLS)"
    },
    "logged_by_user_id": {
      "type": "string",
      "description": "Authenticated actor ID stamped by the outcome service"
    },
    "idempotency_key": {
      "type": "string",
      "maxLength": 128,
      "description": "Actor-scoped retry key stamped by the outcome service"
    },
    "request_hash": {
      "type": "string",
      "description": "Hash of the validated outcome payload used to reject changed retries"
    },
    "outcome_sequence": {
      "type": "integer",
      "description": "Monotonic per-user sequence for outcomes that count toward the free limit"
    },
    "counts_toward_free_limit": {
      "type": "boolean",
      "default": false,
      "description": "Service-owned marker for live Knock Mode outcomes"
    },
    "source": {
      "type": "string",
      "enum": [
        "knock_mode",
        "decision_clear",
        "csv_history_import",
        "workflow_transition"
      ],
      "description": "Trusted write path that created this record"
    },
    "raw_input_text": {
      "type": "string",
      "description": "The exact text the user typed/spoke"
    },
    "parsed_status": {
      "type": "string",
      "enum": [
        "SOLD",
        "QUALIFIED",
        "HARD_NO",
        "CALLBACK",
        "NO_ANSWER",
        "ELIGIBLE",
        "NOT_MOVED_IN",
        "DM_NOT_HOME"
      ],
      "description": "The status derived from the NLP parser"
    },
    "sale_amount": {
      "type": "number",
      "minimum": 0,
      "description": "Dollar amount of the sale if status is SOLD"
    },
    "sale_date": {
      "type": "string",
      "format": "date-time",
      "description": "Client-recorded sale timestamp; created_date remains the server audit timestamp"
    },
    "property_address": {
      "type": "string",
      "maxLength": 500,
      "description": "Address snapshot retained for historical sales reporting"
    },
    "homeowner_name": {
      "type": "string",
      "maxLength": 250,
      "description": "Homeowner snapshot retained for historical sales reporting"
    },
    "rep_id": {
      "type": "string",
      "description": "TeamMember or user ID of the rep who recorded the interaction"
    },
    "rep_name": {
      "type": "string",
      "maxLength": 250,
      "description": "Rep name snapshot retained for historical sales reporting"
    },
    "route_name": {
      "type": "string",
      "maxLength": 250,
      "description": "Route name snapshot retained for historical sales reporting"
    },
    "route_id": {
      "type": "string",
      "description": "SavedRoute this interaction was logged on"
    },
    "gps_proof_lat": {
      "type": "number",
      "description": "Latitude where interaction was recorded"
    },
    "gps_proof_lng": {
      "type": "number",
      "description": "Longitude where interaction was recorded"
    },
    "gps_accuracy": {
      "type": "number",
      "description": "Accuracy radius in meters"
    },
    "image_url": {
      "type": "string",
      "description": "Proof of visit photo"
    },
    "next_eligible_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this property can be knocked again"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description or notes for this record"
    },
    "counts_as_knock": {
      "type": "boolean",
      "default": true,
      "description": "False for administrative workflow transitions that must not inflate activity analytics"
    },
    "workflow_action": {
      "type": "string",
      "enum": [
        "BULK_MOVE_TO_TODO",
        "BULK_MOVE_TO_CALLBACK",
        "BULK_MOVE_TO_RE_KNOCK",
        "CLEAR_TO_TODO"
      ],
      "description": "Administrative transition applied outside a door knock"
    },
    "workflow_bucket": {
      "type": "string",
      "enum": [
        "TODO",
        "CALLBACK",
        "RE_KNOCK"
      ],
      "description": "Optional workflow queue assigned by an administrative transition"
    }
  },
  "required": [
    "address_hash",
    "parsed_status",
    "raw_input_text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "id": "__service_role_only__"
      }
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "manager_id": "{{user.id}}"
        },
        {
          "manager_id": "{{user.data.team_manager_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "id": "__service_role_only__"
      }
    },
    "delete": {
      "$or": [
        {
          "manager_id": "{{user.id}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
