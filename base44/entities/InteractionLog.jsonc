{
  "name": "InteractionLog",
  "type": "object",
  "properties": {
    "address_hash": {
      "type": "string",
      "description": "Link to MasterProperty"
    },
    "manager_id": {
      "type": "string",
      "description": "Manager user ID of the creator's team (tenant key for RLS)"
    },
    "raw_input_text": {
      "type": "string",
      "description": "The exact text the user typed/spoke"
    },
    "parsed_status": {
      "type": "string",
      "enum": [
        "SOLD",
        "HARD_NO",
        "CALLBACK",
        "NO_ANSWER",
        "ELIGIBLE",
        "NOT_MOVED_IN",
        "DM_NOT_HOME"
      ],
      "description": "The status derived from the NLP parser"
    },
    "sale_amount": {
      "type": "number",
      "description": "Dollar amount of the sale if status is SOLD"
    },
    "route_id": {
      "type": "string",
      "description": "SavedRoute this interaction was logged on"
    },
    "gps_proof_lat": {
      "type": "number",
      "description": "Latitude where interaction was recorded"
    },
    "gps_proof_lng": {
      "type": "number",
      "description": "Longitude where interaction was recorded"
    },
    "gps_accuracy": {
      "type": "number",
      "description": "Accuracy radius in meters"
    },
    "image_url": {
      "type": "string",
      "description": "Proof of visit photo"
    },
    "next_eligible_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this property can be knocked again"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description or notes for this record"
    }
  },
  "required": [
    "address_hash",
    "parsed_status",
    "raw_input_text"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "manager_id": "{{user.id}}"
        },
        {
          "manager_id": "{{user.data.team_manager_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "manager_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "manager_id": "{{user.id}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}