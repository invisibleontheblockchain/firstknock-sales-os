{
  "name": "SavedRoute",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "route_mode": {
      "type": "string",
      "enum": [
        "precision",
        "canvas"
      ],
      "default": "precision",
      "description": "Route creation mode: Precision uses paid property acquisition; Canvas is for high-volume door knocking teams."
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "ACTIVE",
        "IN_PROGRESS",
        "COMPLETED",
        "ARCHIVED"
      ],
      "default": "PENDING"
    },
    "assigned_to": {
      "type": "string",
      "description": "TeamMember ID this route is assigned to"
    },
    "assigned_to_name": {
      "type": "string",
      "description": "Cached name for display"
    },
    "priority": {
      "type": "integer",
      "default": 0,
      "description": "Queue order - lower number = higher priority"
    },
    "property_hashes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "distance": {
          "type": "number"
        },
        "house_count": {
          "type": "number"
        },
        "score": {
          "type": "number"
        }
      }
    },
    "start_location": {
      "type": "object",
      "description": "Optional non-personal fixed trip start. Personal home/current coordinates must not be stored on shared routes.",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "address": {
          "type": "string"
        }
      }
    },
    "end_location": {
      "type": "object",
      "description": "Optional non-personal fixed trip endpoint. Personal home/current coordinates must not be stored on shared routes.",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "address": {
          "type": "string"
        }
      }
    },
    "route_origin_mode": {
      "type": "string",
      "enum": [
        "none",
        "home_round_trip",
        "current_to_home"
      ],
      "default": "none",
      "description": "Explicit opt-in routing bounds. none preserves normal route generation behavior."
    },
    "manager_id": {
      "type": "string",
      "description": "ID of the manager who owns this route (tenant key)"
    },
    "metadata": {
      "type": "object",
      "description": "Route metadata such as import source, import date, and source filename"
    },
    "parent_route_id": {
      "type": "string",
      "description": "Original SavedRoute ID when this route is a split child batch"
    },
    "batch_number": {
      "type": "integer",
      "description": "Sequential batch number for split child routes"
    },
    "batch_total": {
      "type": "integer",
      "description": "Total number of batches created from the original route"
    },
    "batch_date": {
      "type": "string",
      "format": "date",
      "description": "Optional calendar date assigned to this split batch"
    }
  },
  "required": [
    "name",
    "property_hashes"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "manager_id": "{{user.id}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "manager_id": "{{user.data.team_manager_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "manager_id": "{{user.id}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "manager_id": "{{user.data.team_manager_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "manager_id": "{{user.id}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
