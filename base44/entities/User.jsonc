{
  "name": "User",
  "type": "object",
  "properties": {
    "app_role": {
      "type": "string",
      "enum": [
        "rep",
        "manager",
        "admin"
      ],
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "team_manager_id": {
      "type": "string",
      "description": "Manager User ID for an invited rep; set by the trusted invite redemption flow and used for exact Canvas tenant binding",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "is_owner": {
      "type": "boolean",
      "default": false,
      "description": "Owner level tier with unlimited caps and elevated permissions",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "subscription_status": {
      "type": "string",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "subscription_tier": {
      "type": "string",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "subscription_id": {
      "type": "string",
      "description": "Client-visible Stripe subscription locator cache. Server access still requires affirmative Stripe metadata ownership.",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "subscription_paid_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Client-visible webhook cache only. Paid entitlement is re-verified from live Stripe state by server functions.",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "subscription_paid_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "subscription_period_start": {
      "type": "string",
      "format": "date-time",
      "description": "Client-visible Stripe period cache; never authoritative for allowance enforcement",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "subscription_period_end": {
      "type": "string",
      "format": "date-time",
      "description": "Current Stripe subscription period end, updated only from verified Stripe state",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "subscription_plan_id": {
      "type": "string",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "precision_usage_period_start": {
      "type": "string",
      "format": "date-time",
      "description": "Client-visible audit cache. Service-owned FetchJob usage and live Stripe state are authoritative.",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "precision_usage_period_end": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "precision_usage_reconciled_at": {
      "type": "string",
      "format": "date-time",
      "description": "Set once when an existing paid account receives its included-trial reconciliation",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "precision_usage_reconciliation_version": {
      "type": "integer",
      "default": 0,
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "precision_trial_properties_credited": {
      "type": "integer",
      "default": 0,
      "description": "Audit value for the one-time included trial-property credit, capped at 50",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "total_seats": {
      "type": "integer",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "stripe_customer_id": {
      "type": "string",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "stripe_card_on_file_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Display cache only. Outcome enforcement verifies attached cards live with Stripe.",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "stripe_card_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "has_seen_onboarding": {
      "type": "boolean"
    },
    "has_pulled_data": {
      "type": "boolean",
      "default": false,
      "description": "Whether user has completed their one-time data pull"
    },
    "has_defined_market": {
      "type": "boolean",
      "default": false
    },
    "territory_zip_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "territory_property_count": {
      "type": "integer",
      "default": 0
    },
    "last_data_pull": {
      "type": "string",
      "format": "date-time"
    },
    "area_pulls_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of area pulls used (free tier = 1)"
    },
    "homes_marked_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of unique homes marked/interacted with (free limit = 100)"
    },
    "outcomes_logged": {
      "type": "integer",
      "default": 0,
      "description": "Service-owned lifetime count of Knock Mode outcomes logged by this user. Never decrements.",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "outcomes_reconciled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When legacy outcomes were reconciled into the protected lifetime counter",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "knock_outcome_lock_token": {
      "type": "string",
      "description": "Short-lived service-owned lease serializing outcome writes for this actor",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "knock_outcome_lock_acquired_at": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "knock_outcome_lock_expires_at": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "working_area": {
      "type": "string",
      "description": "Zip code or City, State for default map center"
    },
    "generated_zip_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "navigation_app": {
      "type": "string"
    },
    "home_base": {
      "type": "object",
      "description": "Optional saved home/base location used only when the user explicitly enables bounded route optimization.",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "address": {
          "type": "string"
        }
      }
    },
    "referral_code": {
      "type": "string",
      "description": "Unique referral code for this user"
    },
    "referral_balance": {
      "type": "number",
      "default": 0,
      "description": "Unpaid referral commission balance in dollars"
    },
    "referral_total_earned": {
      "type": "number",
      "default": 0,
      "description": "Total referral commissions earned all time"
    },
    "referred_by_code": {
      "type": "string",
      "description": "Referral code used when this user signed up"
    },
    "acquisition_first_touch": {
      "type": "object",
      "description": "Immutable first known acquisition touch, captured before auth and written by the attribution service",
      "properties": {
        "source": { "type": "string" },
        "medium": { "type": "string" },
        "campaign": { "type": "string" },
        "content": { "type": "string" },
        "term": { "type": "string" },
        "landing_path": { "type": "string" },
        "referrer_host": { "type": "string" },
        "captured_at": { "type": "string", "format": "date-time" }
      },
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "first_paid_at": {
      "type": "string",
      "format": "date-time",
      "description": "Immutable first verified positive subscription payment timestamp",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "first_paid_subscription_id": {
      "type": "string",
      "description": "Stripe subscription that produced the first verified positive payment",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "first_paid_invoice_id": {
      "type": "string",
      "description": "Stripe invoice proving the first verified positive payment",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "acquisition_last_touch": {
      "type": "object",
      "description": "Most recent known acquisition touch, used for campaign and creative optimization",
      "properties": {
        "source": { "type": "string" },
        "medium": { "type": "string" },
        "campaign": { "type": "string" },
        "content": { "type": "string" },
        "term": { "type": "string" },
        "landing_path": { "type": "string" },
        "referrer_host": { "type": "string" },
        "captured_at": { "type": "string", "format": "date-time" }
      },
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "acquisition_attribution_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the attribution service persisted a touch for this account",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "pull_months_back": {
      "type": "integer",
      "default": 3,
      "description": "How many months back of sold data to include"
    },
    "stale_zips": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "ZIP codes flagged by reconciliation as having drifted from upstream \u2014 forces full pull on next fetch"
    },
    "canvas_deployment_lock_token": {
      "type": "string",
      "description": "Short-lived service-owned token serializing Canvas deployments for this manager",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "canvas_deployment_lock_acquired_at": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "canvas_deployment_lock_expires_at": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    }
  },
  "required": []
}
