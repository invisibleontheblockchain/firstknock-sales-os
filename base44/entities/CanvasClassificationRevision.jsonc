{
  "name": "CanvasClassificationRevision",
  "type": "object",
  "properties": {
    "revision_id": { "type": "string" },
    "revision_hash": { "type": "string" },
    "schema_version": { "type": "integer", "minimum": 1, "default": 1 },
    "manager_id": { "type": "string" },
    "evidence_id": { "type": "string" },
    "parent_revision_id": { "type": "string" },
    "street_unit_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "maxItems": 250,
      "uniqueItems": true
    },
    "original_classifications": {
      "type": "array",
      "items": { "type": "object" }
    },
    "override_canvas_role": {
      "type": "string",
      "enum": ["knock", "transit_only", "excluded", "uncertain"]
    },
    "opportunity_low": { "type": "number", "minimum": 0 },
    "opportunity_expected": { "type": "number", "minimum": 0 },
    "opportunity_high": { "type": "number", "minimum": 0 },
    "override_reason": { "type": "string", "maxLength": 1000 },
    "created_by_user_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "required": [
    "revision_id",
    "revision_hash",
    "schema_version",
    "manager_id",
    "evidence_id",
    "street_unit_ids",
    "original_classifications",
    "override_canvas_role",
    "override_reason",
    "created_by_user_id",
    "created_at"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$or": [
        { "manager_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": { "user_condition": { "id": "__append_only_canvas_classification_revision__" } },
    "delete": { "user_condition": { "id": "__append_only_canvas_classification_revision__" } }
  }
}
