{
  "name": "AffiliateProfile",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "description": "Base44 user ID that owns this referral program"
    },
    "owner_email": {
      "type": "string",
      "description": "Normalized owner email used for legacy referral matching"
    },
    "owner_name": {
      "type": "string"
    },
    "referral_code": {
      "type": "string",
      "description": "Unique code included in the partner referral link"
    },
    "program": {
      "type": "string",
      "enum": [
        "volume_partner"
      ],
      "default": "volume_partner"
    },
    "base_rate_pct": {
      "type": "number",
      "default": 10
    },
    "threshold_active_customers": {
      "type": "integer",
      "default": 50
    },
    "qualified_rate_pct": {
      "type": "number",
      "default": 25
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused"
      ],
      "default": "active"
    }
  },
  "required": [
    "owner_user_id",
    "owner_email",
    "referral_code",
    "program",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}