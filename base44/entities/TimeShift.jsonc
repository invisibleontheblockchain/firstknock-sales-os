{
  "name": "TimeShift",
  "type": "object",
  "properties": {
    "revision": { "type": "integer", "default": 0 },
    "adjusted": { "type": "boolean", "default": false },
    "audit_trail": { "type": "array", "items": { "type": "object", "properties": {
      "request_id": { "type": "string" }, "action": { "type": "string" },
      "actor_id": { "type": "string" }, "actor_name": { "type": "string" }, "at": { "type": "string" },
      "reason": { "type": "string" }, "before_start": { "type": "string" }, "before_end": { "type": "string" },
      "after_start": { "type": "string" }, "after_end": { "type": "string" }
    } } },
    "correction_requests": { "type": "array", "items": { "type": "object", "properties": {
      "request_id": { "type": "string" }, "actor_id": { "type": "string" }, "at": { "type": "string" },
      "reason": { "type": "string" }, "start_at": { "type": "string" }, "end_at": { "type": "string" },
      "status": { "type": "string", "enum": ["pending", "resolved"] }, "resolved_at": { "type": "string" }, "resolved_by": { "type": "string" }
    } } },
    "manager_id": {
      "type": "string"
    },
    "member_id": {
      "type": "string"
    },
    "rep_user_id": {
      "type": "string"
    },
    "rep_name": {
      "type": "string"
    },
    "rep_email": {
      "type": "string"
    },
    "invite_code": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "closed"
      ]
    },
    "clock_in_at": {
      "type": "string",
      "format": "date-time"
    },
    "clock_out_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_by": {
      "type": "string"
    }
  },
  "required": [
    "manager_id",
    "member_id",
    "rep_user_id",
    "request_id",
    "status",
    "clock_in_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "id": "__service_role_only__"
      }
    },
    "read": {
      "user_condition": {
        "id": "__service_role_only__"
      }
    },
    "update": {
      "user_condition": {
        "id": "__service_role_only__"
      }
    },
    "delete": {
      "user_condition": {
        "id": "__service_role_only__"
      }
    }
  }
}
