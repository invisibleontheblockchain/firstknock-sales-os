    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "test": "node --test test/*.test.mjs",
    "test:analytics": "node --test test/analytics-specific-date.test.mjs",
    "test:billing": "node --test test/billing-upgrade.test.mjs",
    "test:auth-origin": "node --test test/auth-origin.test.mjs",
    "test:precision-usage": "node --test test/billing-upgrade.test.mjs test/precision-property-usage.test.mjs test/precision-pull-cap.test.mjs test/precision-cancellation.test.mjs",
    "test:custom-range": "node --test test/custom-ownership-range.test.mjs",
    "test:route-bounds": "node --test test/route-bounds.test.mjs test/route-bounds-integration.test.mjs",
    "test:fieldroutes": "node --test test/fieldroutes-backend.test.mjs test/fieldroutes-manager-ui.test.mjs test/fieldroutes-rep-ui.test.mjs",
    "test:canvas-evidence": "node --test test/canvas-evidence-contract.test.mjs test/canvas-evidence-release-builder.test.mjs",
