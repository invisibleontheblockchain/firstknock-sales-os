    "canvas:maryland:worker": "node scripts/canvas-evidence/statewide/maryland-build-worker.mjs",
    "canvas:maryland:status": "node scripts/canvas-evidence/statewide/maryland-build-worker.mjs --status",
    "canvas:sources:verify": "node scripts/canvas-evidence/source-artifacts/verify-source-manifest.mjs",
    "canvas:artifacts:upload-r2": "node scripts/canvas-evidence/source-artifacts/upload-r2.mjs",
    "smoke:fieldroutes:readonly": "node scripts/fieldroutes-readonly-smoke.mjs",
    "typecheck": "tsc -p ./jsconfig.validation.json",
    "validate:dependencies": "npm audit --audit-level=high",
    "validate:backend": "node scripts/validate-backend.mjs",
    "validate:canvas:production": "node scripts/check-canvas-production-readiness.mjs",
    "validate:canvas:scale": "node --test --test-concurrency=1 test/canvas-national-scale-validation.test.mjs test/canvas-residential-planner-worker.test.mjs test/canvas-assignment-package-backend.test.mjs test/canvas-offline-foundation.test.mjs test/canvas-offline-package-runtime.test.mjs test/canvas-operational-api.test.mjs",
    "validate:artifact": "node scripts/validate-artifact.mjs",
    "validate": "npm run lint && npm run typecheck && npm run validate:dependencies && npm test && npm run validate:backend && npm run build && npm run validate:artifact",
    "preview": "vite preview",
    "mobile:build": "vite build && cap sync"
  },
