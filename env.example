VITE_BASE44_APP_ID=695eb764b077190880be21de
VITE_BASE44_APP_BASE_URL=https://firstknock.online

# Required for production Canvas builds. Local development may omit these and
# use the explicitly development-only map fallback.
VITE_CANVAS_BASEMAP_TILE_URL=https://<contracted-or-self-hosted-tile-origin>/{z}/{x}/{y}.png
# Low-cost national alternative: configure this instead of the XYZ URL above.
# VITE_CANVAS_BASEMAP_PMTILES_URL=https://<r2-or-cdn-origin>/firstknock-us.pmtiles
# VITE_CANVAS_BASEMAP_PMTILES_FLAVOR=dark
VITE_CANVAS_BASEMAP_ATTRIBUTION=<required-provider-attribution>

# Public trust anchor compiled into the rep app. These must be the exact public
# key, format, and key ID paired with the Base44 Canvas package signer. The app
# never trusts a public key returned beside a package over the API.
VITE_CANVAS_PACKAGE_SIGNING_PUBLIC_KEY=<base64-spki-der-ed25519-public-key>
VITE_CANVAS_PACKAGE_SIGNING_PUBLIC_KEY_FORMAT=spki
VITE_CANVAS_PACKAGE_SIGNING_KEY_ID=canvas-field-packages-<yyyy-mm>

# Optional; URL and attribution must be configured together.
# VITE_CANVAS_SATELLITE_TILE_URL=https://<contracted-satellite-origin>/{z}/{x}/{y}.jpg
# VITE_CANVAS_SATELLITE_ATTRIBUTION=<required-satellite-attribution>
