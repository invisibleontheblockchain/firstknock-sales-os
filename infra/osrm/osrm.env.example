# Copy to osrm.env and replace every CHANGE_ME value.
# 26.7.3 is intentionally pinned while the same-day 26.8.0 release soaks.
OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:26.7.3-debian@sha256:a7091038e39a73659767f34ef2d389909b42ea80b09bd2bdca482dce2991cbad
# The helper defaults to the full Geofabrik United States extract (50 states
# plus DC). Set a timestamped URL for every reproducible production build.
# OSRM_REGION_URL=https://download.geofabrik.de/north-america/us-YYMMDD.osm.pbf
# Nationwide builds are too large for this repository/OneDrive directory. Use
# a dedicated >=1 TB build volume; serving replicas should use local NVMe.
OSRM_DATA_ROOT=/CHANGE_ME_LOCAL_NVME/firstknock-osrm
OSRM_DATA_DIR=/CHANGE_ME_LOCAL_NVME/firstknock-osrm/builds/CHANGE_ME
OSRM_DATASET_BASE=us.osrm
OSRM_DATA_VERSION=CHANGE_ME
OSRM_BUILD_FINGERPRINT=CHANGE_ME_64_HEX_CHARACTERS
OSRM_COVERAGE_ID=us-50-states-dc
# Engine-visible guards for a nominal 192+ GB RAM / 1 TB disk builder.
OSRM_MIN_BUILD_RAM_GIB=176
OSRM_MIN_BUILD_FREE_DISK_GIB=800

# FirstKnock currently presents these as walking routes. Build a separate car
# graph if the product workflow is changed to driving between properties.
OSRM_PROFILE_FILE=foot.lua
OSRM_API_PROFILE=foot

OSRM_THREADS=8
OSRM_MAX_TABLE_SIZE=100
OSRM_MAX_ROUTE_SIZE=100
OSRM_DEFAULT_RADIUS_METERS=150
OSRM_HEALTH_START_PERIOD=10m

# Keep loopback for local development. In production, expose the gateway only
# through a private network, firewall allowlist, or TLS load balancer.
OSRM_GATEWAY_BIND=127.0.0.1
OSRM_GATEWAY_PORT=8080
OSRM_GATEWAY_TOKEN=CHANGE_ME_64_HEX_CHARACTERS
