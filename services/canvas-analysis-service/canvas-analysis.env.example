# FORMAT REFERENCE ONLY. Store real values in the service secret manager, never in git.
# CANVAS_DATABASE_URL may use a different database role from Base44, but it must
# address the same Canvas logical database and must never be a Precision URL.

CANVAS_DATABASE_URL=postgresql://<canvas-analysis-role>:<password>@<host>/<canvas-database>?sslmode=require
CANVAS_ANALYSIS_SERVICE_TOKEN=<same-independent-token-configured-in-base44>

# The release ID in this path must equal manifest.release.release_id.
CANVAS_EVIDENCE_MANIFEST_URL=https://<artifact-origin>/canvas/releases/<cer1_release_id>/manifest.json
CANVAS_EVIDENCE_MANIFEST_PUBLIC_KEY=<base64-spki-der-ed25519-public-key>
CANVAS_EVIDENCE_MANIFEST_KEY_ID=canvas-evidence-<yyyy-mm>
# CANVAS_EVIDENCE_BEARER_TOKEN=<optional-read-only-origin-token>

CANVAS_SERVICE_MODE=both
CANVAS_WORKER_CONCURRENCY=2
CANVAS_WORKER_POLL_MS=1000
CANVAS_WORKER_LEASE_MS=120000
CANVAS_DATABASE_MAX_CONNECTIONS=10
CANVAS_MAX_MANIFEST_BYTES=67108864
CANVAS_MANIFEST_CACHE_TTL_MS=300000
HOST=0.0.0.0
PORT=8080
